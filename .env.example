# ZMETA

# Credenciales locales. Copia este archivo a .env y rellena los valores.
# .env no se sube al repositorio.

# MongoDB
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=zmeta

# Google Gemini. Crea la clave en https://aistudio.google.com/apikey
# GEMINI_MODEL es opcional. Por defecto se usa gemini-3.8-flash.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# twitterapi.io — búsqueda de perfiles y temas
TWITTER_API_IO_KEY=

# RapidAPI — descarga de Reels de Instagram
RAPIDAPI_KEY=
RAPIDAPI_HOST_INSTAGRAM=

# Orígenes extra permitidos, separados por coma.
# Vacío = solo el mismo origen. "*" abre cualquier origen, sin credenciales.
CORS_ORIGINS=
